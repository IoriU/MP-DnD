{
  "name": "dungeon-delvers",
  "private": true,
  "version": "0.1.0",
  "description": "Co-op multiplayer D&D-style roguelike that runs in the browser",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,cyan \"node --watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.ts",
    "play": "vite build && node server/index.ts",
    "tunnel": "cloudflared tunnel --url http://localhost:3000",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.ts",
    "test": "node --test \"tests/*.test.ts\"",
    "balance": "node scripts/balance.ts",
    "balance-farm": "node scripts/balance-farm.ts",
    "resume-check": "node scripts/resume-check.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "express": "^5.3.0",
    "phaser": "^4.2.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
